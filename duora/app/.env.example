# Duora app — Expo public config (inlined at build time)
# Copy to .env (never commit the real file). Restart expo after edits.

# ─── Local development ───
# Android emulator → host machine:
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000/api/v1"
EXPO_PUBLIC_WS_URL="http://10.0.2.2:4000"

# Physical device on same Wi-Fi → your computer's LAN IP:
# EXPO_PUBLIC_API_BASE_URL="http://192.168.1.20:4000/api/v1"
# EXPO_PUBLIC_WS_URL="http://192.168.1.20:4000"

# ─── Personal Render deployment (free tier) ───
# After you deploy duora-server on Render, replace with your Render URL:
# EXPO_PUBLIC_API_BASE_URL="https://duora-server.onrender.com/api/v1"
# EXPO_PUBLIC_WS_URL="https://duora-server.onrender.com"
# On Render free tier the server sleeps after 15 min idle — first request
# after sleep takes ~30s to wake. The app shows a gentle "Reconnecting" banner.

# Environment label shown in Developer Info
EXPO_PUBLIC_ENV="development"
# EXPO_PUBLIC_ENV="production"  # use with Render URL

# Optional explicit version endpoint (defaults to "<API base>/app/version")
# EXPO_PUBLIC_VERSION_ENDPOINT=""

# Expo project ID for push (https://expo.dev) — only if you configured FCM
EXPO_PUBLIC_EAS_PROJECT_ID=""

# Duora app — Expo public config (inlined at build time)
# Copy to .env (never commit the real file). Restart expo after edits.
#
# The app talks to ONE base URL. Leave this unset to use the production
# deployment (https://duora.onrender.com) that is compiled in as the default.

# ─── Production (Render) ───────────────────────────────────────────────
# EXPO_PUBLIC_API_URL="https://duora.onrender.com"

# ─── Local development ─────────────────────────────────────────────────
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"
#
# Physical device on the same Wi-Fi → your computer's LAN IP:
# EXPO_PUBLIC_API_URL="http://192.168.1.20:4000"
#
# iOS simulator → http://localhost:4000
#
# On the Render free tier the server sleeps after 15 minutes idle and the
# first request after that takes ~30 s to wake it up. The app shows a gentle
# "Reconnecting" state and retries on its own.

# Environment label shown in the app's developer info
# EXPO_PUBLIC_ENV="production"

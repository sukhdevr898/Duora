# Duora app configuration. Expo inlines EXPO_PUBLIC_* vars at build time.
# Copy to .env (never commit the real file).

# Android emulator → host machine loopback:
EXPO_PUBLIC_API_BASE_URL="http://10.0.2.2:4000/api/v1"
# Physical device on the same LAN → use your computer's LAN IP, e.g.:
# EXPO_PUBLIC_API_BASE_URL="http://192.168.1.20:4000/api/v1"
# Remote testing/production must use HTTPS, e.g. "https://api.duora.example.com/api/v1"

# Socket.IO base URL (no /api/v1 suffix):
EXPO_PUBLIC_WS_URL="http://10.0.2.2:4000"
# EXPO_PUBLIC_WS_URL="https://api.duora.example.com"

# development | staging | production
EXPO_PUBLIC_ENV="development"

# Optional explicit update endpoint. Defaults to "<API base>/app/version".
# Contract: GET ?platform=android&version=<installed> →
# { latestVersion, minSupportedVersion, updateAvailable, updateRequired, releaseUrl, checkedAt }
# EXPO_PUBLIC_VERSION_ENDPOINT=""

# Expo project ID for EAS/expo-notifications development (https://expo.dev)
EXPO_PUBLIC_EAS_PROJECT_ID=""

// Duora — Prisma schema (PostgreSQL)
// Durable source of truth for identity, pairing, messages, calls and devices.
// Never replace these tables with in-memory maps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PairingStatus {
  ACTIVE
  UNLINKED
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum MessageType {
  TEXT
  ATTACHMENT
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  CONNECTING
  ACTIVE
  ENDED
  DECLINED
  CANCELLED
  MISSED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  // Local nickname the user gives their partner (kept on the user row)
  partnerNickname String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshSessions RefreshSession[]
  devices         Device[]
  invitationsSent PairingInvitation[] @relation("InvitationCreator")
  invitationsUsed PairingInvitation[] @relation("InvitationConsumer")
  pairingsA       Pairing[]           @relation("PairingUserA")
  pairingsB       Pairing[]           @relation("PairingUserB")
  messages        Message[]
  receipts        MessageReceipt[]
  hiddenMessages  HiddenMessage[]
  callsInitiated  CallSession[]       @relation("Caller")
  callsReceived   CallSession[]       @relation("Callee")
  settings        UserSettings?
  presence        Presence?
  conversationParticipants ConversationParticipant[]

  @@index([deletedAt])
  @@map("users")
}

model RefreshSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the opaque refresh token — raw tokens are never stored
  tokenHash   String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FCM/Expo push token. A token can move between accounts, so unique without owner.
  pushToken   String   @unique
  platform    String
  deviceId    String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
  @@map("devices")
}

model Pairing {
  id         String        @id @default(cuid())
  userAId    String
  userBId    String
  userA      User          @relation("PairingUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User          @relation("PairingUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status     PairingStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  unlinkedAt DateTime?
  conversation Conversation?

  // A user may only hold one ACTIVE pairing. Enforced in service + partial indexes below.
  @@index([userAId, status])
  @@index([userBId, status])
  @@map("pairings")
}

model PairingInvitation {
  id           String           @id @default(cuid())
  // Human-short code, e.g. "DUO-482913" (rate-limited verification endpoint)
  code         String           @unique
  // Opaque token embedded in the QR code — never a password or refresh token
  token        String           @unique
  createdById  String
  createdBy    User             @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  consumedById String?
  consumedBy   User?            @relation("InvitationConsumer", fields: [consumedById], references: [id])
  status       InvitationStatus @default(PENDING)
  attemptCount Int              @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([status, expiresAt])
  @@index([createdById])
  @@map("pairing_invitations")
}

model Conversation {
  id         String                   @id @default(cuid())
  pairingId  String                   @unique
  pairing    Pairing                  @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // Client-generated UUID for idempotent send + offline dedupe
  clientMessageId String
  type            MessageType  @default(TEXT)
  text            String
  attachmentUrl   String?
  attachmentMeta  Json?
  replyToId       String?
  replyTo         Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  deletedForAllAt DateTime?
  createdAt       DateTime     @default(now())
  receipts        MessageReceipt[]
  hiddenBy        HiddenMessage[]

  // Idempotency: one durable message per client id inside a conversation
  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageReceipt {
  messageId    String
  userId       String
  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt  DateTime?
  readAt       DateTime?

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@map("message_receipts")
}

// "Delete for me" — per-user hiding without touching the durable record
model HiddenMessage {
  messageId   String
  userId      String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt    DateTime @default(now())

  @@id([messageId, userId])
  @@map("hidden_messages")
}

model CallSession {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  caller      User       @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee      User       @relation("Callee", fields: [calleeId], references: [id], onDelete: Cascade)
  callType    CallType
  status      CallStatus @default(RINGING)
  endReason   String?
  startedAt   DateTime?
  connectedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status])
  @@map("call_sessions")
}

model Presence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  online     Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("presence")
}

model UserSettings {
  userId               String  @id
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String  @default("system") // system | light | dark
  messageNotifications Boolean @default(true)
  callNotifications    Boolean @default(true)
  ringtone             String  @default("default")
  vibration            Boolean @default(true)
  hidePreview          Boolean @default(false)
  lowData              Boolean @default(false)
  updatedAt            DateTime @updatedAt

  @@map("user_settings")
}

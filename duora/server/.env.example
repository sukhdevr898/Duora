# ---------------------------------------------------------------------------
# Duora API — environment
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- database --------------------------------------------------------------
# SQLite (default, zero setup — the file lives in ./data/duora.db)
DATABASE_URL=file:./data/duora.db
# Render managed Postgres — swap the value and everything else stays the same
# DATABASE_URL=postgresql://duora:password@host/duora

# --- auth ------------------------------------------------------------------
# Use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=duora-dev-access-secret-change-me
JWT_REFRESH_SECRET=duora-dev-refresh-secret-change-me
ACCESS_TTL=30d
REFRESH_TTL_DAYS=30

# --- networking ------------------------------------------------------------
# Comma separated list of allowed origins, or empty to allow any origin.
CORS_ORIGINS=
# Public URL of this deployment — used to build avatar / photo links.
# PUBLIC_BASE_URL=https://duora-server.onrender.com

# --- misc ------------------------------------------------------------------
LOG_LEVEL=info
APP_VERSION=2.0.0
REGION=Singapore · ap-southeast
PAIRING_TTL_MINUTES=10
# Seed the demo couple (sukhdev@duora.app / love1234) on boot.
SEED_ON_BOOT=false

# ─────────────────────────────────────────────────────────────
# Duora server — personal lightweight config
# Copy to .env and fill only what you need. Never commit .env.
# Optimized for Render free tier: only 3 vars are mandatory.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Render free tier sets PORT=10000 automatically — leave PORT empty there,
# or set to 10000. The server binds to 0.0.0.0:${PORT}.

# PostgreSQL — local:
DATABASE_URL="postgresql://duora:duora@localhost:5432/duora?schema=public"
# Render blueprint: this is injected automatically from duora-db.
# For Neon/Supabase free tier, add ?sslmode=require to the URL:
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/duora?sslmode=require"

# Public origin of this server (used for CORS + release links)
PUBLIC_BASE_URL="http://10.0.2.2:4000"
# On Render: PUBLIC_BASE_URL="https://duora-server.onrender.com"
CORS_ORIGINS="http://localhost:8081,http://10.0.2.2:8081"
# On Render leave CORS_ORIGINS="" — mobile apps send no Origin and are always allowed.

# JWT — generate two *different* secrets (run twice):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-hex-chars"
JWT_REFRESH_SECRET="replace-with-64-hex-chars-different"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Pairing invitations (short-lived, single-use)
INVITATION_TTL_MINUTES=10
INVITATION_MAX_ATTEMPTS=5

# ── Optional — leave empty for lightweight personal use ──
# Firebase FCM: only if you want background push. Without it,
# chat/calls still work while the app/socket is open — push is just
# a wake-up. Skipped gracefully when not configured.
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# TURN: only for strict NATs (e.g. mobile carrier → mobile carrier).
# Default OFF for personal use — STUN (Google) handles most home Wi-Fi.
# To enable, set TURN_ENABLED=true and provide TURN_SECRET + TURN_URLS.
TURN_ENABLED=false
TURN_SECRET=""
TURN_TTL_SECONDS=3600
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URLS=""

# Attachments: OFF by default for personal lightweight.
# Saves disk + TURN-like bandwidth. Flip to true only if you need images/files.
ATTACHMENTS_ENABLED=false
ATTACHMENT_MAX_BYT=10485760
ATTACHMENT_DIR="./data/attachments"

# In-app update contract (GET /api/v1/app/version)
ANDROID_LATEST_VERSION="1.0.0"
ANDROID_MIN_SUPPORTED_VERSION="1.0.0"
ANDROID_RELEASE_URL="https://play.google.com/store/apps/details?id=com.duora.app"

# Lightweight logging: 'warn' on Render (less wakeups), 'info' locally.
LOG_LEVEL=info
# LOG_LEVEL=warn  # uncomment for Render free tier

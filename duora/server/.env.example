# ---------------------------------------------------------------------------
# Duora API — environment
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- database --------------------------------------------------------------
# Local development (default): an embedded SQLite file, zero setup.
DATABASE_URL=file:./data/duora.db

# Production — Supabase Postgres. Copy this from
#   Supabase → Project Settings → Database → Connection string → URI
# and reset the password there if you have never seen it.
#
# Use the POOLED host (…pooler.supabase.com) because Render has no IPv6:
#
#   DATABASE_URL=postgresql://postgres.jfttevfwqonxasoahiby:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# The direct host from the Supabase dashboard works on a machine with IPv6
# (or through the Supabase SQL editor), but NOT on Render:
#
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.jfttevfwqonxasoahiby.supabase.co:5432/postgres
#
# Percent-encode special characters in the password (@ → %40, : → %3A, / → %2F).

# How long to keep retrying while the database wakes up.
DB_CONNECT_ATTEMPTS=12
DB_CONNECT_DELAY_MS=5000
# `sqlite` lets the server boot with a local file if Postgres is unreachable.
DB_FALLBACK=none

# --- Supabase Auth (optional) ----------------------------------------------
# With these set the API can also use Supabase Auth:
#   • POST /api/v1/auth/login falls back to Supabase Auth
#   • every protected route also accepts a Supabase access token (verified
#     with the project's JWKS)
#   • new accounts are mirrored into Supabase Auth (needs the secret key)
#
# The project is "sukhdevr898's Project" (ref jfttevfwqonxasoahiby).
SUPABASE_URL=https://jfttevfwqonxasoahiby.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Bzsts1IXPpMZI0XphKTZqg_EKLyDznT
# The secret key is server-only — never put it in the app bundle.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://jfttevfwqonxasoahiby.supabase.co/auth/v1/.well-known/jwks.json

# --- auth ------------------------------------------------------------------
# Use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=duora-dev-access-secret-change-me
JWT_REFRESH_SECRET=duora-dev-refresh-secret-change-me
ACCESS_TTL=30d
REFRESH_TTL_DAYS=30

# --- networking ------------------------------------------------------------
# Comma separated list of allowed origins, or empty to allow any origin.
CORS_ORIGINS=
# Public URL of this deployment — used to build avatar / photo links.
# PUBLIC_BASE_URL=https://duora.onrender.com

# --- misc ------------------------------------------------------------------
LOG_LEVEL=info
APP_VERSION=3.0.0
REGION=Singapore · ap-southeast
PAIRING_TTL_MINUTES=10
# Seed the demo couple (sukhdev@duora.app / love1234) on boot.
SEED_ON_BOOT=false

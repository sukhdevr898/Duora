# ---------------------------------------------------------------------------
# Duora API — environment
# Copy to `.env` for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- database --------------------------------------------------------------
# Local development (default): an embedded SQLite file, zero setup.
DATABASE_URL=file:./data/duora.db

# Production — Supabase Postgres. Copy this from
#   Supabase → Project Settings → Database → Connection string → URI
# Use the POOLED host (…pooler.supabase.com) because Render has no IPv6:
#
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# How long to keep retrying while the database wakes up.
DB_CONNECT_ATTEMPTS=12
DB_CONNECT_DELAY_MS=5000
# `sqlite` lets the server boot with a local file if Postgres is unreachable.
DB_FALLBACK=none

# --- auth ------------------------------------------------------------------
# Use long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=duora-dev-access-secret-change-me
JWT_REFRESH_SECRET=duora-dev-refresh-secret-change-me
ACCESS_TTL=30d
REFRESH_TTL_DAYS=30

# --- networking ------------------------------------------------------------
# Comma separated list of allowed origins, or empty to allow any origin.
CORS_ORIGINS=
# Public URL of this deployment — used to build avatar / photo links.
# PUBLIC_BASE_URL=https://duora.onrender.com

# --- misc ------------------------------------------------------------------
LOG_LEVEL=info
APP_VERSION=3.0.0
REGION=Singapore · ap-southeast
PAIRING_TTL_MINUTES=10
# Seed the demo couple (sukhdev@duora.app / love1234) on boot.
SEED_ON_BOOT=false

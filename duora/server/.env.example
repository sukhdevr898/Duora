# ─────────────────────────────────────────────────────────────
# Duora server environment. Copy to .env and fill real values.
# Never commit .env. All secrets must come from environment vars.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma datasource)
DATABASE_URL="postgresql://duora:duora@localhost:5432/duora?schema=public"

# Public origin of this server, used for CORS and release links
PUBLIC_BASE_URL="http://10.0.2.2:4000"
# Comma-separated allowed browser/device origins for CORS
CORS_ORIGINS="http://localhost:8081,http://10.0.2.2:8081"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-64-hex-chars"
JWT_REFRESH_SECRET="replace-with-64-hex-chars-different"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Pairing invitation lifetime in minutes (short-lived by design)
INVITATION_TTL_MINUTES=10
# Max verification attempts before an invitation code is locked
INVITATION_MAX_ATTEMPTS=5

# Firebase Admin (FCM). Provide EITHER a path to the service account JSON
# OR the three individual vars. If absent, push sends are skipped (logged).
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# TURN (coturn REST API, RFC-like short-lived credentials).
# TURN_SECRET must match coturn's static-auth-secret.
TURN_ENABLED=true
TURN_SECRET="replace-with-long-random-secret"
TURN_TTL_SECONDS=3600
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"

# Uploads (optional attachments). Attachments are stored on disk in dev;
# in production prefer object storage and a signed-URL service.
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_BYT=10485760
ATTACHMENT_DIR="./data/attachments"

# In-app update contract served at GET /api/v1/app/version
ANDROID_LATEST_VERSION="1.0.0"
ANDROID_MIN_SUPPORTED_VERSION="1.0.0"
ANDROID_RELEASE_URL="https://play.google.com/store/apps/details?id=com.duora.app"

LOG_LEVEL=info
